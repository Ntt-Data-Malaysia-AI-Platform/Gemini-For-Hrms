# --- Browser (VITE_* values are bundled into the web app: never put secrets here) ---
# Microsoft Entra ID app registration used for the HR (Tessa) Microsoft 365 sign-in.
# Add http://localhost:5173 as a "Single-page application" redirect URI.
VITE_CLIENT_ID=your-entra-app-client-id
VITE_TENANT_ID=your-entra-tenant-id

# --- Server only (read by server/, never sent to the browser) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# SAP SuccessFactors. Sandbox: an API key from the SAP Business Accelerator Hub (api.sap.com).
SAP_API_KEY=your-sap-api-hub-key
# Real tenant instead of the sandbox (Basic auth user@companyId):
# SAP_BASE_URL=https://apiXX.successfactors.com/odata/v2
# SAP_USERNAME=
# SAP_PASSWORD=

# Jira Cloud: IT & Facilities requests are raised as Jira issues and their status is read back live.
# API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
# Optional: project key (default: the first project the account can see) and issue type (default: Task)
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# Optional: comma-separated Microsoft 365 emails allowed into HR operations (empty = anyone in the tenant).
HR_ALLOWED_USERS=
# Optional: show "Continue as Tessa (demo)" on the landing page when Microsoft 365 is not ready.
ALLOW_DEMO_HR=false
API_PORT=8787

# Microsoft Teams: channel webhook (Teams > channel > Workflows > "Post to a channel when a webhook request is received").
TEAMS_WEBHOOK_URL=
# Public HTTPS address of the app (used by the Teams tab package and the "Open" button on Teams cards).
APP_URL=
